# Copy to .env and fill in, or run "npm run setup", which does both and fills the secrets. Never commit .env.
# Generate secrets by hand with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=8080

# Name in the header, page titles and emails.
APP_NAME=Express.js Template
# Public address, used for links in emails. Required in production and must use https there.
APP_URL=http://localhost:8080
# Language for visitors whose browser asks for none of the supported ones: de or en.
DEFAULT_LOCALE=en

# Database. Empty = SQLite file data/app.db, nothing to install. Other examples:
#   mongodb://user:password@127.0.0.1:27017/expressjs_template
#   postgres://user:password@127.0.0.1:5432/expressjs_template
#   mysql://user:password@127.0.0.1:3306/expressjs_template      (also mariadb://)
#   mssql://user:password@127.0.0.1:1433/expressjs_template      (npm install tedious)
#   oracle://user:password@127.0.0.1:1521/FREEPDB1               (npm install oracledb)
DATABASE_URL=
# MongoDB only: the database to use, takes precedence over a name in the URL.
DATABASE_NAME=expressjs_template
# Optional: an account that may change the schema. When set, the app only checks the schema on start and
# "npm run migrate" applies changes with this account, so DATABASE_URL can use an account without DDL rights.
MIGRATION_DATABASE_URL=

# Required in production, at least 32 characters, different from each other.
# Outside production missing secrets are replaced by random values per process.
JWT_SECRET=
SESSION_SECRET=
# Encrypts two-factor secrets in the database. Changing it later makes existing 2FA setups unusable.
ENCRYPTION_KEY=

JWT_ISSUER=expressjs-template
JWT_AUDIENCE=expressjs-template-api
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Comma-separated origins allowed to call /v1 from a browser, e.g. https://app.example.com
# Empty = no cross-origin access. "*" is rejected in production.
CORS_ORIGIN=

SESSION_NAME=sid
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Defaults to true in production and cannot be disabled there.
SESSION_COOKIE_SECURE=

# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs and secure cookies.
# Required in production (at least 1): the app only runs behind a TLS-terminating proxy there.
TRUST_PROXY=0

# Swagger UI under /docs. Defaults to off in production.
API_DOCS_ENABLED=

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# memory = per process. database = shared by all instances behind a load balancer.
RATE_LIMIT_STORE=memory

# Email. Without SMTP_URL (allowed outside production only) messages are written to the log.
# Production requires TLS: smtps:// (port 465) or a server that offers STARTTLS on port 587.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Express.js Template <no-reply@localhost>
# true = sign-in only after the email address is confirmed.
AUTH_REQUIRE_VERIFIED_EMAIL=false

# How long the activity log keeps events, in days.
AUDIT_RETENTION_DAYS=180

# Bearer token for GET /metrics (Prometheus). Empty = endpoint switched off (404).
METRICS_TOKEN=

# Animation style of the web pages: film, precise, playful, calm or off.
MOTION_STYLE=film
# Lets visitors pick another style in the footer.
MOTION_SWITCH=true

LOG_LEVEL=info

# Only for docker compose: credentials of the bundled MongoDB. The app connects with the app user,
# which may only read and write its own database. Use long random values of letters and digits only,
# because they become part of a connection URL.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=app
MONGO_APP_PASSWORD=
