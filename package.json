{
  "name": "expressjs-template",
  "version": "4.0.0",
  "description": "Security-hardened Express.js 5 template with a REST API, JWT authentication, a browser UI with CSRF-protected sessions, OpenAPI docs and tests.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-preserve-output src/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:perf": "cross-env NODE_ENV=test node tests/performance/run.js",
    "audit": "npm audit --audit-level=moderate",
    "licenses": "node scripts/check-licenses.js --write",
    "check": "npm run lint && npm run format:check && npm test && npm run audit",
    "setup": "node scripts/setup.js",
    "copy-database": "node scripts/copy-database.js",
    "create-admin": "node scripts/create-admin.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "generate": "node scripts/generate-resource.js",
    "build:preview": "node scripts/build-preview.js",
    "preview": "node scripts/e2e-server.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "prepare": "simple-git-hooks"
  },
  "keywords": [
    "express",
    "express5",
    "api",
    "template",
    "jwt",
    "security",
    "owasp",
    "mongodb",
    "starter"
  ],
  "author": "VectoDE (Tim Hauke)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VectoDE/ExpressJS-Template.git"
  },
  "bugs": {
    "url": "https://github.com/VectoDE/ExpressJS-Template/issues"
  },
  "homepage": "https://github.com/VectoDE/ExpressJS-Template#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uqr": "^0.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    },
    "hyperid": {
      "uuid": "^11.1.1"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write --ignore-unknown"
  },
  "optionalDependencies": {
    "oracledb": "^26.0.0",
    "tedious": "^20.3.7"
  }
}
