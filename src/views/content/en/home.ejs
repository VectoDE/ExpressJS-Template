<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title" class="hero__title" data-split>Express.js, secure out of the box</h1>
    <p class="hero__lead">
      REST API, sign-in with a second factor, password reset by email, account self-service and user management in one
      project. The groundwork is secured and tested, so your code starts with the actual job.
    </p>
    <div class="button-row">
      <% if (isAuthenticated) { %>
      <a class="button button--primary button--large" href="/dashboard">Go to my account</a>
      <% } else { %>
      <a class="button button--primary button--large" href="/register">Create an account</a>
      <% } %>
      <a class="button button--secondary button--large" href="#story-title">Follow a request</a>
    </div>
  </div>
  <%- include('../../components/header-check', { headers, caption: 'This response came with ' + headers.length + ' security headers' }) %>
</section>

<%- include('../../components/story', {
  id: 'story',
  heading: 'The path of a request',
  lead: 'Before your code sees a request, it passes seven stations. Scroll along.',
  steps: [
    { title: 'Arrival', code: 'X-Request-Id: 7c1e…', text: 'Every request gets an ID that shows up in each log line and on error pages. Anything larger than 100 KB is rejected before the server reads it.' },
    { title: 'Headers', code: "Content-Security-Policy: default-src 'self'", text: 'A Content Security Policy without inline scripts, HSTS, COOP, COEP and a Permissions-Policy that blocks camera, microphone and location.' },
    { title: 'Rate limit', code: 'RateLimit-Policy: 300;w=900', text: '300 requests per 15 minutes and IP, 10 failed attempts on sign-in and password forms. With RATE_LIMIT_STORE=database several instances share the counters.' },
    { title: 'Origin', code: 'Sec-Fetch-Site: same-origin', text: 'Forms carry a CSRF token that is masked anew each time it is rendered. Posts from other sites already fail the Fetch Metadata check.' },
    { title: 'Input', code: '400 "email" must be a valid email', text: 'Joi checks every field against a schema and rejects unknown ones. MongoDB operators and prototype keys are stripped first.' },
    { title: 'Identity', code: 'Authorization: Bearer eyJhbGciOiJIUzI1NiJ9…', text: 'Session cookie or JWT, the role comes from the database, with a second factor if the user turned it on. After a password change, old tokens and sessions stop working.' },
    { title: 'Response', code: '200 OK', text: 'Errors reveal no internals, only an error ID. Duration and status end up as a Prometheus metric.' },
  ],
}) %>

<%- include('../../components/feature-grid', {
  id: 'features',
  heading: 'What is inside',
  features: [
    { title: 'API and browser', text: 'JSON API under /v1 with access and refresh tokens, plus server-rendered pages with session sign-in. OpenAPI docs at /docs.' },
    { title: 'Complete sign-in', text: 'Sign-up, email confirmation, forgotten password, two-factor with an authenticator app and recovery codes.' },
    { title: 'Accounts users control', text: 'Profile, password, signed-in devices, activity log, data export and deletion, as the GDPR requires.' },
    { title: 'Administration', text: 'Find users, assign roles and delete accounts, in the browser and through the API with the same rights.' },
    { title: 'Two languages', text: 'Interface and emails in German and English. Another language is one more file.' },
    { title: 'Ready for production', text: 'Docker, health checks, Prometheus metrics, structured logs with request IDs and a load test for every endpoint.' },
  ],
}) %>

<%- include('../../components/quickstart', {
  id: 'quickstart',
  heading: 'Running locally in three commands',
  lead: 'Node.js 22 is enough: the data goes to SQLite until DATABASE_URL names MongoDB, PostgreSQL, MySQL or another server. Setup writes a .env with random keys.',
  commands: [
    { command: 'npm run setup', text: 'Create .env with your own keys' },
    { command: 'npm run create-admin', text: 'Create the first administrator' },
    { command: 'npm run dev', text: 'Start the server, restart on changes' },
  ],
}) %>
