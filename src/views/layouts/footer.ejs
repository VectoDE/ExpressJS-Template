<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__meta">
      &copy; <%= new Date().getFullYear() %> <%= app.name %><% if (app.version) { %>, <%= t('common.version', { version: app.version }) %><% } %>
    </p>
    <nav aria-label="<%= t('nav.legal') %>">
      <ul class="site-footer__links">
        <li><a href="/imprint"><%= t('nav.imprint') %></a></li>
        <li><a href="/privacy"><%= t('nav.privacy') %></a></li>
        <li><a href="/security"><%= t('nav.security') %></a></li>
      </ul>
    </nav>
    <% if (app.motion.switcher) { %><%- include('../components/motion-switch') %><% } %>
    <%- include('../components/language-switch') %>
  </div>
</footer>
