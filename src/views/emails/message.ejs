<%#
  HTML version of every transactional email. Email clients ignore stylesheets, so styles are inline and
  the layout is a single table. Locals: lang, subject, greeting, intro, action, outro, notYou, signature.
-%>
<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= subject %></title>
  </head>
  <body style="margin:0;padding:0;background:#f3f5f2;color:#18201b;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5f2;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #d6ddd7;border-radius:12px;">
            <tr>
              <td style="padding:28px 32px 8px;border-top:4px solid #17663f;border-radius:12px 12px 0 0;">
                <p style="margin:0 0 20px;font-size:13px;font-weight:600;color:#17663f;"><%= subject %></p>
                <p style="margin:0 0 16px;font-size:16px;line-height:1.6;"><%= greeting %></p>
                <p style="margin:0 0 24px;font-size:16px;line-height:1.6;"><%= intro %></p>
                <% if (action) { %>
                <p style="margin:0 0 24px;">
                  <a href="<%= action.url %>" style="display:inline-block;background:#17663f;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:12px 22px;border-radius:8px;"><%= action.label %></a>
                </p>
                <p style="margin:0 0 24px;font-size:13px;line-height:1.5;color:#4a564e;word-break:break-all;"><%= action.url %></p>
                <% } %>
                <% if (outro) { %><p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:#4a564e;"><%= outro %></p><% } %>
                <% if (notYou) { %>
                <p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:#4a564e;"><%= notYou.text %> <a href="<%= notYou.url %>" style="color:#17663f;"><%= notYou.url %></a></p>
                <% } %>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 24px;border-top:1px solid #e3e8e4;font-size:12px;line-height:1.5;color:#5d6a61;"><%= signature %></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
