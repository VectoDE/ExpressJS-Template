<%- include('../../layouts/top', { bodyClass: 'page-auth', width: 'auth' }) %>
<div class="auth-layout">
  <section class="panel auth-panel">
    <%- include('../../components/page-intro', { heading: t('auth.forgot.title'), lead: t('auth.forgot.lead') }) %>
    <form method="post" action="/forgot-password" class="form">
      <%- include('../../components/csrf') %>
      <%- include('../../components/field', {
        id: 'email', name: 'email', label: t('fields.email'), type: 'email', value: old.email,
        autocomplete: 'email', maxlength: 254, required: true,
      }) %>
      <button type="submit" class="button button--primary button--block"><%= t('auth.forgot.submit') %></button>
    </form>
    <p class="panel__footer"><a href="/login"><%= t('auth.forgot.back') %></a></p>
  </section>
  <%- include('../../components/auth-steps', { steps: [
    { key: 'address', state: 'current' }, { key: 'link', state: 'next' }, { key: 'newPassword', state: 'next' },
  ] }) %>
</div>
<%- include('../../layouts/bottom') %>
