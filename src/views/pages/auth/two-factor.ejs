<%- include('../../layouts/top', { bodyClass: 'page-auth', width: 'auth' }) %>
<div class="auth-layout">
  <section class="panel auth-panel">
    <%- include('../../components/page-intro', { heading: t('auth.twoFactor.title'), lead: t('auth.twoFactor.lead') }) %>
    <form method="post" action="/login/2fa" class="form">
      <%- include('../../components/csrf') %>
      <%- include('../../components/code-field', {
        id: 'code', label: t('fields.code'), help: t('auth.twoFactor.recoveryHint'), recovery: true, autofocus: true,
      }) %>
      <button type="submit" class="button button--primary button--block"><%= t('auth.twoFactor.submit') %></button>
    </form>
    <% if (locals.passkeyOptions) { %>
    <form method="post" action="/login/2fa/passkey" class="form passkey-option" data-passkey="get" data-passkey-options="<%= JSON.stringify(passkeyOptions) %>" data-passkey-cancelled="<%= t('auth.twoFactor.passkeyCancelled') %>" hidden>
      <%- include('../../components/csrf') %>
      <input type="hidden" name="response" value="" />
      <p class="form__intro"><%= t('auth.twoFactor.passkeyHint') %></p>
      <p class="form__status" data-passkey-status role="status" aria-live="polite"></p>
      <button type="submit" class="button button--secondary button--block"><%= t('auth.twoFactor.passkey') %></button>
    </form>
    <% } %>
    <p class="panel__footer"><a href="/login"><%= t('auth.twoFactor.cancel') %></a></p>
  </section>
  <%- include('../../components/auth-steps', { timer: true, steps: [
    { key: 'credentials', state: 'done' }, { key: 'code', state: 'current' }, { key: 'signedIn', state: 'next' },
  ] }) %>
</div>
<%- include('../../layouts/bottom') %>
