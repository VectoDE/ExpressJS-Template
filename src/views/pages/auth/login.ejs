<%- include('../../layouts/top', { bodyClass: 'page-auth', width: 'auth' }) %>
<div class="auth-layout">
  <section class="panel auth-panel">
    <%- include('../../components/page-intro', { heading: t('auth.login.title') }) %>
    <form method="post" action="/login" class="form">
      <%- include('../../components/csrf') %>
      <%- include('../../components/field', {
        id: 'email', name: 'email', label: t('fields.email'), type: 'email', value: old.email,
        autocomplete: 'email', maxlength: 254, required: true,
      }) %>
      <%- include('../../components/field', {
        id: 'password', name: 'password', label: t('fields.password'), type: 'password',
        autocomplete: 'current-password', maxlength: 128, required: true,
      }) %>
      <p class="form__aside"><a href="/forgot-password"><%= t('auth.login.forgot') %></a></p>
      <button type="submit" class="button button--primary button--block"><%= t('auth.login.submit') %></button>
    </form>
    <p class="panel__footer"><%= t('auth.login.noAccount') %> <a href="/register"><%= t('auth.login.register') %></a></p>
  </section>
  <%- include('../../components/auth-steps', { steps: [
    { key: 'credentials', state: 'current' }, { key: 'code', state: 'next' }, { key: 'signedIn', state: 'next' },
  ] }) %>
</div>
<%- include('../../layouts/bottom') %>
