<%- include('../../layouts/top', { bodyClass: 'page-auth', width: 'auth' }) %>
<div class="auth-layout">
  <section class="panel auth-panel">
    <%- include('../../components/page-intro', { heading: t('auth.register.title'), lead: t('auth.register.lead') }) %>
    <form method="post" action="/register" class="form">
      <%- include('../../components/csrf') %>
      <%- include('../../components/field', {
        id: 'name', name: 'name', label: t('fields.name'), value: old.name,
        autocomplete: 'name', minlength: 3, maxlength: 120, required: true,
      }) %>
      <%- include('../../components/field', {
        id: 'email', name: 'email', label: t('fields.email'), type: 'email', value: old.email,
        autocomplete: 'email', maxlength: 254, required: true,
      }) %>
      <%- include('../../components/field', {
        id: 'password', name: 'password', label: t('fields.password'), type: 'password',
        autocomplete: 'new-password', minlength: 12, maxlength: 128, required: true, help: t('fields.passwordHelp'),
      }) %>
      <button type="submit" class="button button--primary button--block"><%= t('auth.register.submit') %></button>
    </form>
    <p class="panel__footer"><%= t('auth.register.haveAccount') %> <a href="/login"><%= t('auth.register.signIn') %></a></p>
  </section>
  <%- include('../../components/auth-steps', { steps: [
    { key: 'account', state: 'current' }, { key: 'confirm', state: 'next' }, { key: 'start', state: 'next' },
  ] }) %>
</div>
<%- include('../../layouts/bottom') %>
